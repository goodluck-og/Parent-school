# --- Database ---
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# In Atlas, under Network Access, allow access from anywhere (0.0.0.0/0) so Vercel can connect.
MONGODB_URI=

# --- Auth ---
# Any long random string — used to sign login sessions. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# One-time secret used only to create the first Owner account via /api/auth/seed-owner.
# Pick any password-like string, use it once, then you can leave it or change it.
SEED_SECRET=

# --- AI assistant ---
# Get a key at https://console.anthropic.com — needed for the AI assistant to actually respond.
# Without this, the assistant will politely say it isn't connected yet.
ANTHROPIC_API_KEY=
